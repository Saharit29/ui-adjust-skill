{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ui-adjust config",
  "type": "object",
  "required": [
    "themes"
  ],
  "properties": {
    "defaultTheme": {
      "type": "string"
    },
    "spacingUnit": {
      "type": "number",
      "default": 8
    },
    "radiusUnit": {
      "type": "number",
      "default": 8
    },
    "nearThreshold": {
      "type": "number",
      "default": 40
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "colors"
        ],
        "properties": {
          "wrapper": {
            "type": "string",
            "description": "Component that applies this theme via a nested ThemeProvider"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colors": {
            "type": "object",
            "description": "#HEX → MUI palette path (error.light) or Tailwind color name (danger-50)",
            "additionalProperties": {
              "type": "string"
            }
          },
          "typography": {
            "type": "object",
            "description": "MUI: variant → px · Tailwind: text-* key → px",
            "additionalProperties": {
              "type": "number"
            }
          },
          "handled": {
            "type": "object",
            "description": "#HEX → why the theme already applies it",
            "additionalProperties": {
              "type": "string"
            }
          },
          "shadows": {
            "type": "object",
            "description": "MUI: theme.shadows index → box-shadow · Tailwind: shadow-* key → value",
            "additionalProperties": {
              "type": "string"
            }
          },
          "radius": {
            "type": "object",
            "description": "Tailwind: rounded-* key → px",
            "additionalProperties": {
              "type": "number"
            }
          },
          "containers": {
            "type": "object",
            "description": "Tailwind: max-w-* key → px",
            "additionalProperties": {
              "type": "number"
            }
          },
          "projectColors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tailwind: the project's own color tokens — the only ones a near color may snap to"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "button": {
          "type": [
            "string",
            "null"
          ]
        },
        "dialog": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmDialog": {
          "type": [
            "string",
            "null"
          ]
        },
        "emptyState": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "import": {
          "type": [
            "string",
            "null"
          ]
        },
        "sizeLocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalog": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themeSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format": {
      "enum": [
        "mui",
        "tailwind"
      ],
      "default": "mui",
      "description": "Which converter output and check-ui rules apply"
    }
  }
}
